<schema xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:framework:Setup/Declaration/Schema/etc/schema.xsd">
    <!--
        Reminder bookkeeping is carried on the quote itself (no extra table):
        - magenx_abandoned_notified_at: timestamp of the LAST reminder sent
          (NULL = never reminded). Used both to skip already-reminded carts and
          to space out repeat reminders.
        - magenx_abandoned_reminder_count: how many reminders have gone out, so
          the cron can honour a "max reminders" cap.
        These are written with a targeted UPDATE (see ReminderResource) so the
        quote's own updated_at is NOT bumped — bumping it would push the cart
        back out of the abandoned window.
    -->
    <table name="quote" resource="checkout" engine="innodb">
        <column xsi:type="timestamp" name="magenx_abandoned_notified_at" on_update="false" nullable="true"
                comment="Abandoned cart: when the last reminder was sent (NULL = never)"/>
        <column xsi:type="smallint" name="magenx_abandoned_reminder_count" unsigned="true" nullable="false" default="0"
                comment="Abandoned cart: number of reminders sent for this quote"/>
        <!--
            (is_active, updated_at) only: the candidate query's notified_at
            condition is "IS NULL OR reminder_count < ?" (an OR across two
            columns), which the optimizer can't use as an equality on a
            middle index column, so including notified_at here would block
            the index from serving the updated_at range filter and the
            ORDER BY updated_at ASC ... LIMIT. notified_at / reminder_count
            stay as cheap unindexed post-filters on the already-narrowed
            row set. Reference id is kept as-is (no whitelist change needed).
        -->
        <index referenceId="MAGENX_ABANDONED_QUOTE_IS_ACTIVE_NOTIFIED_UPDATED" indexType="btree">
            <column name="is_active"/>
            <column name="updated_at"/>
        </index>
    </table>
</schema>
